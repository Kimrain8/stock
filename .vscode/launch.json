{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug dashboard.server",
      "type": "debugpy",
      "request": "launch",
      "module": "dashboard.server",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "APP_LOG_LEVEL": "DEBUG"
      }
    },
    {
      "name": "Debug: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}